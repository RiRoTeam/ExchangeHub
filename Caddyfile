{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
		-Server
	}

	request_body {
		max_size 2MB
	}

	@privateEndpoints path /actuator* /swagger-ui* /v3/api-docs*
	respond @privateEndpoints 404

	@api path /api/*
	handle @api {
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-store"

	handle {
		reverse_proxy frontend:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}
}
