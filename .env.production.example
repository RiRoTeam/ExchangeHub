# Copy to .env.production and replace every example value before deployment.
# This file contains non-secret settings only. Secret material belongs in
# deploy/secrets/ and must never be committed.
COMPOSE_PROJECT_NAME=exchangehub-production
RELEASE_TAG=replace-with-git-sha
DOMAIN=exchangehub.example.com
ACME_EMAIL=ops@example.com

POSTGRES_ADMIN_USER=exchangehub_admin
DB_NAME=exchangehub
DB_APP_USER=exchangehub_app

SECRETS_DIR=./deploy/secrets
BACKEND_MEMORY_LIMIT=1024m
POSTGRES_MEMORY_LIMIT=1024m
